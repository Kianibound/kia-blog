# Server-only backend origin. No /api prefix: /api is Swagger UI.
# Required at runtime for the server-rendered public article feed.
API_BASE_URL=http://localhost:3000

# Server-only auth and session foundation (Issues #58-#59). Required by email
# login/registration CSRF tokens and authenticated sessions; the public article
# feed does not need them. Sessions fail closed when any value is missing.
# Generate the key: openssl rand -base64 32
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SESSION_ENCRYPTION_KEY=
# Exact frontend origin used for CSRF Origin checks (no path or query).
APP_ORIGIN=http://localhost:3001

# Optional, publicly visible HTTPS profile URLs. Leave blank to show decorative icons.
SOCIAL_GITHUB_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_TWITTER_URL=
